# Copy to .env and fill in. `.env` is gitignored — never commit real keys.

# Required. Without this every AI endpoint returns 503.
OPENAI_API_KEY=sk-...

# Models. Terra balances quality/cost; Luna handles cheap high-volume tasks.
OPENAI_CHAT_MODEL=gpt-5.6-terra
OPENAI_TRIAGE_MODEL=gpt-5.6-terra
OPENAI_CHEAP_MODEL=gpt-5.6-luna

# Change this in production. Used to sign JWTs.
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_MINUTES=20160

DATABASE_URL=sqlite:///./ailawyer.db

# Comma-separated. Expo web dev server + Vite admin dev server.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:5173

# Seeded admin account (created by `python -m app.seed`)
ADMIN_EMAIL=admin@ailawyer.app
ADMIN_PASSWORD=admin12345
